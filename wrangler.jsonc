{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neohive",
  "compatibility_date": "2026-04-05",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false
    }
  },
  "assets": {
    "directory": "website"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
